<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="tutorialCategoryObject"
            type="com.aavidsoft.freshersbuddy.tutorials.models.ItemCategory" />

    </data>
    <androidx.cardview.widget.CardView
        android:layout_width="100dp"
        android:layout_height="110dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp"
        style="@style/my_custom_style"
        app:cardBackgroundColor="@android:color/white"
        android:layout_margin="8dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:background="@android:color/white">

            <ImageView
                android:id="@+id/iconsTutorials"
                android:layout_width="70dp"
                android:layout_height="60dp"
                android:scaleType="fitCenter"
                android:layout_marginLeft="5dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                imageurl="@{tutorialCategoryObject.imageUrl}" />

            <TextView
                android:id="@+id/title_icon"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@{tutorialCategoryObject.name}"
                android:textColor="@color/black"
                android:textSize="14sp"
                android:textStyle="bold"
                android:gravity="center"
                app:layout_constraintTop_toBottomOf="@id/iconsTutorials"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

</layout>