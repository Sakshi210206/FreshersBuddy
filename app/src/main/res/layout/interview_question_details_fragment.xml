<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="interviewQuestionDetailItems"
            type="com.aavidsoft.freshersbuddy.interviewquestion.allinterviewquestions.models.InterviewQuestionItemDetails" />
    </data>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/my_custom_style"
        app:cardCornerRadius="12dp"
        app:cardElevation="25dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        >

    <androidx.constraintlayout.widget.ConstraintLayout
        style="@style/my_styles"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:id="@+id/InterviewQuestion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="question"
            style="@style/my_styles"
            android:textSize="20sp"
            android:textColor="@color/primary_color"
            android:text="@{interviewQuestionDetailItems.question}"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/interviewQuestionAnswer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/my_styles"
            android:hint="answer"
            android:text="@{interviewQuestionDetailItems.answer}"
            android:textSize="20sp"
            android:textColor="@color/primary_color"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/InterviewQuestion" />

    </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

</layout>